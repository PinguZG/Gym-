# --- App ---
DATABASE_URL=./data/hub.db
ORIGIN=http://localhost:3000
ALLOW_REGISTRATION=false
# Domain für Caddy (Produktion)
HUB_DOMAIN=hub.example.com

# --- Integrationen: off | mock | live ---
INTEGRATION_APPLE=mock
INTEGRATION_GARMIN=mock
INTEGRATION_YAZIO=mock
INTEGRATION_RENPHO=mock
# Token für Apple-Health-Ingest (Bearer). Erzeugen: openssl rand -hex 32
APPLE_INGEST_TOKEN=change-me
# Interne URL des Python-Sync-Sidecars
SYNC_URL=http://sync:8000
SYNC_SHARED_SECRET=change-me

# --- Zugangsdaten nur für live (niemals committen) ---
GARMIN_EMAIL=
GARMIN_PASSWORD=
YAZIO_EMAIL=
YAZIO_PASSWORD=
RENPHO_EMAIL=
RENPHO_PASSWORD=
