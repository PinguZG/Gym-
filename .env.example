# --- App ---
DATABASE_URL=./data/hub.db
# Nur lokal ohne Docker; im Compose wird ORIGIN aus HUB_DOMAIN abgeleitet
ORIGIN=http://localhost:5173
ALLOW_REGISTRATION=false
# Betreiber-Mail: darf Live-Sync auslösen; Apple-Ingest schreibt in dieses Konto
HUB_OWNER_EMAIL=du@example.com
APPLE_INGEST_USER_EMAIL=du@example.com
# Hinter Caddy: echte Client-IP für Rate-Limit
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
# Domain für Caddy (Produktion)
HUB_DOMAIN=hub.example.com

# --- Integrationen: off | mock | live ---
INTEGRATION_APPLE=mock
INTEGRATION_GARMIN=mock
INTEGRATION_YAZIO=mock
INTEGRATION_RENPHO=mock
# Token für Apple-Health-Ingest (Bearer, min. 32 Zeichen). Erzeugen: openssl rand -hex 32
APPLE_INGEST_TOKEN=
# Interne URL des Python-Sync-Sidecars
SYNC_URL=http://sync:8000
SYNC_SHARED_SECRET=

# --- Zugangsdaten nur für live (niemals committen) ---
GARMIN_EMAIL=
GARMIN_PASSWORD=
YAZIO_EMAIL=
YAZIO_PASSWORD=
RENPHO_EMAIL=
RENPHO_PASSWORD=
